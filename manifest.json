{
  "manifest_version": 3,
  "name": "Yekun Dream",
  "version": "1.2.0",
  "description": "Acompanhe seu progresso em animes, mangás e webtoons — 100% livre, privado e sem coleta de dados pessoais. Desenvolvido por Sentsuy (Sentsuy Corp).",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Yekun Dream"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js":      ["canonical-resolver.js", "alias-crowd-service.js", "storage-local.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at":  "document_idle"
    }
  ]
}
