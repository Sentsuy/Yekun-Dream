{
  "manifest_version": 3,
  "name": "Chapter Tracker",
  "version": "1.1.0",
  "description": "Salve e acompanhe seu progresso em mangás, séries e animes — com botão flutuante em qualquer página.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Chapter Tracker"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js":      ["storage-local.js", "content.js"],
      "run_at":  "document_idle"
    }
  ]
}
